# ==============================================================================
# Rastogi Traders — Production Environment Configuration (.env.production)
# ==============================================================================

# Core Django Security
SECRET_KEY=django-insecure-prod-replace-with-a-random-50-character-string-in-production
DEBUG=False
ALLOWED_HOSTS=rastogitraders.com,www.rastogitraders.com,your-app.onrender.com

# CSRF Trusted Origins (Comma-separated HTTPS domains)
CSRF_TRUSTED_ORIGINS=https://rastogitraders.com,https://www.rastogitraders.com,https://your-app.onrender.com

# HTTPS & Cookie Security Flags (Recommended True for Live HTTPS Production)
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Database Connection (Leave empty for SQLite with persistent volume, or provide PostgreSQL connection string)
# DATABASE_URL=postgresql://user:password@host:5432/rastogi_db

# Business Contact & Communication Defaults
BUSINESS_PHONE=+919876543210
WHATSAPP_NUMBER=+919876543210
BUSINESS_EMAIL=contact@rastogitraders.com
GOOGLE_MAPS_URL=https://maps.google.com
